{
	auto_https disable_redirects
}

https://{$INTELSOC_GATEWAY_HOST}:8445 {
	tls internal

	@ingestion {
		method POST
		path /api/v1/events/windows /api/v1/events/linux /api/v1/devices/enroll
	}

	handle @ingestion {
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not Found" 404
	}
}


# Private IntelSOC dashboard gateway.
https://localhost:8443 {
    bind 127.0.0.1
    tls internal

    @dashboard_read {
        method GET
        path /api/v1/auth/me /api/v1/dashboard/summary /api/v1/events /api/v1/alerts /api/v1/incidents /api/v1/devices /api/v1/ai/analysis /api/v1/ai/summary /api/v1/services/status /api/v1/users
    }

    handle @dashboard_read {
        reverse_proxy 127.0.0.1:8000
    }

    @investigation_read {
        method GET
        path_regexp investigation ^/api/v1/(alerts/[^/]+(/(ti|risk))?|incidents/[^/]+|devices/[^/]+)$
    }

    handle @investigation_read {
        reverse_proxy 127.0.0.1:8000
    }

    @auth_write {
        method POST
        path /api/v1/auth/login /api/v1/auth/logout /api/v1/auth/activate /api/v1/auth/forgot-password /api/v1/auth/reset-password /api/v1/auth/change-password
    }

    handle @auth_write {
        request_body {
            max_size 4KB
        }
        reverse_proxy 127.0.0.1:8000
    }

    @user_management_read {
        method GET
        path_regexp user_details ^/api/v1/users/[^/]+$
    }

    handle @user_management_read {
        reverse_proxy 127.0.0.1:8000
    }

    @user_management_write {
        method POST
        path_regexp user_write ^/api/v1/users(/[^/]+/(resend-invitation|reset-password))?$
    }

    handle @user_management_write {
        request_body {
            max_size 4KB
        }
        reverse_proxy 127.0.0.1:8000
    }

    @user_lifecycle_write {
        method PATCH
        path_regexp user_lifecycle ^/api/v1/users/[^/]+/(status|role)$
    }

    handle @user_lifecycle_write {
        request_body {
            max_size 4KB
        }
        reverse_proxy 127.0.0.1:8000
    }

    @device_write {
        method PATCH
        path_regexp device_write ^/api/v1/devices/[^/]+/criticality$
    }

    handle @device_write {
        request_body {
            max_size 4KB
        }
        reverse_proxy 127.0.0.1:8000
    }

    # Serve only the compiled dashboard on the loopback HTTPS listener.
    @frontend_assets {
        method GET HEAD
        path /assets/*
    }
    handle @frontend_assets {
        root * ./frontend/dist
        header X-Content-Type-Options nosniff
        file_server
    }

    @frontend_pages {
        method GET HEAD
        path / /login /activate /forgot-password /reset-password /events /alerts /incidents /ai /devices /users /health /settings
    }
    handle @frontend_pages {
        root * ./frontend/dist
        header {
            Cache-Control "no-store"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
        rewrite * /index.html
        file_server
    }

    handle {
        respond "Not Found" 404
    }
}
