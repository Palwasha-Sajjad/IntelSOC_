{
	auto_https disable_redirects
}

https://{$INTELSOC_GATEWAY_HOST}:8445 {
	tls internal

	@ingestion {
		method POST
		path /api/v1/events/windows /api/v1/events/linux
	}

	handle @ingestion {
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not Found" 404
	}
}
